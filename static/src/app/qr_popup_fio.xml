<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="fio_qr_payment_validation.QRConfirmationDialog" t-inherit="point_of_sale.QRConfirmationDialog" t-inherit-mode="extension">
        <xpath expr="//img[@alt='QR Code']" position="attributes">
            <attribute name="t-if">fio.status !== 'confirmed'</attribute>
        </xpath>
        <xpath expr="//img[@alt='QR Code']" position="after">
            <div t-if="fio.status === 'confirmed'" class="fio_qr_confirmed alert alert-success text-center my-2 px-4 py-3">
                <i class="fa fa-check-circle fa-3x d-block mb-2" role="img" aria-label="Potvrzeno"/>
                <div class="h4 mb-1">Automaticky potvrzeno</div>
                <div t-if="fio.detail" class="small" t-out="fio.detail"/>
                <div class="small text-muted mt-1">Dokonči objednávku tlačítkem „Potvrdit platbu“.</div>
            </div>
            <div t-elif="fio.status === 'checking'" class="fio_qr_checking w-100 mt-2" style="max-width: 320px;">
                <div class="d-flex justify-content-between small text-muted">
                    <span><i class="fa fa-refresh fa-spin me-1" role="img" aria-label="Kontrola"/>Čekám na platbu v bance…</span>
                    <span class="ms-2 text-nowrap">
                        <span class="fio_qr_countdown" t-esc="fioCountdownLabel"/>
                        <span class="fio_qr_interval ms-1 opacity-75">(<t t-esc="fioIntervalLabel"/>)</span>
                    </span>
                </div>
                <div class="progress mt-1" style="height: 6px;">
                    <div class="progress-bar bg-info fio_qr_progress" role="progressbar" t-attf-style="width: {{ fioProgressPercent }}%; transition: width 0.25s linear;"/>
                </div>
            </div>
            <div t-elif="fio.status === 'error'" class="fio_qr_error small text-warning mt-2" t-out="fio.detail"/>
        </xpath>
        <!-- po potvrzení bankou je hlavní akcí Potvrdit platbu (zelené), Zrušit ustoupí -->
        <xpath expr="//button[@t-on-click='_confirm']" position="attributes">
            <attribute name="class" remove="btn-secondary" separator=" "/>
            <attribute name="t-att-class">{ 'btn-success': fio.status === 'confirmed', 'btn-secondary': fio.status !== 'confirmed' }</attribute>
        </xpath>
        <xpath expr="//button[@t-on-click='_cancel']" position="attributes">
            <attribute name="class" remove="btn-primary" separator=" "/>
            <attribute name="t-att-class">{ 'btn-primary': fio.status !== 'confirmed', 'btn-secondary': fio.status === 'confirmed' }</attribute>
        </xpath>
    </t>

</templates>
