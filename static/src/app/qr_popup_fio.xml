<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Odoo 20: dialog QR platby je point_of_sale.QRPopup (dřív QRConfirmationDialog). -->
    <t t-name="fio_qr_payment_validation.QRPopup" t-inherit="point_of_sale.QRPopup" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('qr-container')]" position="attributes">
            <attribute name="t-if">this.fio.status !== 'confirmed'</attribute>
        </xpath>
        <xpath expr="//div[hasclass('qr-container')]" position="after">
            <div t-if="this.fio.status === 'confirmed'" class="fio_qr_confirmed alert alert-success text-center my-2 px-4 py-3 w-75">
                <i class="oi oi-3x oi-filled d-block mb-2" data-icon="check_circle" role="img" aria-label="Potvrzeno"/>
                <div class="h4 mb-1">Automaticky potvrzeno</div>
                <div t-if="this.fio.detail" class="small" t-out="this.fio.detail"/>
                <div class="small text-muted mt-1">Dokonči objednávku potvrzením platby.</div>
            </div>
            <div t-elif="this.fio.status === 'checking'" class="fio_qr_checking w-75 mb-2" style="max-width: 320px;">
                <div class="d-flex flex-wrap justify-content-between column-gap-2 small text-muted">
                    <span class="text-nowrap"><i class="oi oi-spin me-1" data-icon="autorenew" role="img" aria-label="Kontrola"/>Čekám na platbu v bance…</span>
                    <span class="text-nowrap">
                        <span class="fio_qr_countdown" t-out="this.fioCountdownLabel()"/>
                        <span class="fio_qr_interval ms-1 opacity-75">(<t t-out="this.fioIntervalLabel()"/>)</span>
                    </span>
                </div>
                <div class="progress mt-1" style="height: 6px;">
                    <div class="progress-bar bg-info fio_qr_progress" role="progressbar" t-attf-style="width: {{ this.fioProgressPercent() }}%; transition: width 0.25s linear;"/>
                </div>
            </div>
            <div t-elif="this.fio.status === 'error'" class="fio_qr_error small text-warning mb-2" t-out="this.fio.detail"/>
        </xpath>
        <!-- po potvrzení bankou je potvrzení platby zelené -->
        <xpath expr="//button[hasclass('confirm-button')]" position="attributes">
            <attribute name="class" remove="btn-primary" separator=" "/>
            <attribute name="t-att-class">{ 'btn-success': this.fio.status === 'confirmed', 'btn-primary': this.fio.status !== 'confirmed' }</attribute>
        </xpath>
    </t>

</templates>
