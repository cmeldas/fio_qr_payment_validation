<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Odoo 20: QR na displeji jsou data z PosPayment.getQrPopupProps() (this.qrData), modul k nim
         přidává fioConfirmed. Potvrzení překryje jen levý panel displeje (tam, kde je QR kód),
         seznam zboží vpravo zůstává vidět. Drží, dokud obsluha v pokladně platbu nepotvrdí nebo
         nezruší (pokladna pak QR z dat odebere). -->
    <t t-name="fio_qr_payment_validation.CustomerDisplay" t-inherit="point_of_sale.CustomerDisplay" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_customer_display_sidebar')]" position="attributes">
            <attribute name="class" add="position-relative" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('o_customer_display_sidebar')]" position="inside">
            <div t-if="this.qrData.qrCode and this.qrData.fioConfirmed"
                 class="fio_customer_confirmed position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center text-center text-white p-4"
                 style="z-index: 3000; background: rgba(25, 135, 84, 0.97);">
                <i class="oi oi-filled mb-3" data-icon="check_circle" style="font-size: 7rem;" role="img" aria-label="Zaplaceno"/>
                <div class="display-4 fw-bold">Platba přijata</div>
                <div t-if="orderPrices?.total_amount" class="display-5 fw-bold mt-2" t-out="orderPrices.total_amount"/>
                <div class="fs-3 mt-3">Automaticky potvrzeno bankou. Děkujeme!</div>
            </div>
        </xpath>
    </t>

</templates>
