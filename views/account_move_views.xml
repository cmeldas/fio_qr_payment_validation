<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_fio" model="ir.ui.view">
        <field name="name">account.move.form.fio</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_fio_transactions" type="object" class="oe_stat_button" icon="account_balance"
                        invisible="fio_transaction_count == 0">
                    <field name="fio_transaction_count" widget="statinfo" string="Pohyby Fio"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
