<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_fio" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.fio</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='customer_display']" position="after">
                <setting id="fio_pending_qr" string="Nespárované QR platby v liště" help="Ikona s počtem QR plateb, které banka ještě nepotvrdila; kliknutím seznam s proklikem na objednávku.">
                    <div class="content-group mt16">
                        <div class="row">
                            <label for="pos_fio_pending_days" class="col-lg-4 o_light_label"/>
                            <field name="pos_fio_pending_days" class="col-lg-2"/>
                        </div>
                        <div class="text-muted">Počítají se platby z objednávek této pokladny za posledních N dní (0 = bez omezení).</div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
