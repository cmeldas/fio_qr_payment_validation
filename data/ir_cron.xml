<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Běží každých 5 minut; Fio se ale ptá jen když je některá pokladna otevřená (heartbeat
             z lišty pokladny do 10 minut), jinak nejvýš jednou za hodinu. -->
        <record id="cron_fio_sync" model="ir.cron">
            <field name="name">Fio: stáhnout nové pohyby a spárovat platby</field>
            <field name="model_id" ref="model_res_partner_bank"/>
            <field name="state">code</field>
            <field name="code">model._cron_fio_sync()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Spouští se jen přes _trigger (import historie po blocích), pravidelný běh je odsunutý daleko. -->
        <record id="cron_fio_history" model="ir.cron">
            <field name="name">Fio: import historie pohybů (po blocích)</field>
            <field name="model_id" ref="model_res_partner_bank"/>
            <field name="state">code</field>
            <field name="code">model._cron_fio_history_step()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=3650)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
